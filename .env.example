# Environment Configuration Template
# Copy to .env and configure your local credentials. Do not commit .env to version control.

# Target environment: set to testnet for safe execution
TADEX_TARGET_ENV=testnet

# Bybit V5 API credentials (Testnet)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true

# Optional: Path to Tadex repository for signal parser verification
TADEX_REPO_PATH=C:\Users\user\Documents\Tadex

# Optional: Supabase configuration (if publishing signals to Tadex platform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TADEX_STRATEGY_PROVIDER_ID=
